<resources>
    <!-- 应用浅色主题（Material 3） -->
    <style name="Theme.AppDefault" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorBrandPrimary</item>
        <item name="colorOnPrimary">@color/colorBrandOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorBrandContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorBrandOnContainer</item>

        <item name="colorSecondary">@color/colorBrandPrimary</item>
        <item name="colorOnSecondary">@color/colorBrandOnPrimary</item>
        <item name="colorSecondaryContainer">@color/colorBrandContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorBrandOnContainer</item>

        <item name="colorError">@color/colorDanger</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/colorDangerContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnDangerContainer</item>

        <item name="android:colorBackground">@color/colorThemeBackground</item>
        <item name="colorSurface">@color/colorSurfaceCard</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceSubtle</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="colorOutline">@color/colorStrokeSubtle</item>
        <item name="colorOutlineVariant">@color/colorDivider</item>

        <item name="android:statusBarColor">@color/colorThemeBackground</item>
        <item name="android:navigationBarColor">@color/colorThemeBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize15Percent" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="NoDisplay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFrame">@null</item>
        <!-- 设置是否可滑动 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 设置是否透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- 无标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 背景 -->
        <item name="android:background">@null</item>
        <!-- 窗口背景 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- 是否变暗 -->
        <item name="android:backgroundDimEnabled">false</item>
        <!-- 点击空白部分activity不消失 -->
        <item name="android:windowCloseOnTouchOutside">true</item>
        <!-- 无标题 有的手机设置这行代码-->
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoDisplay">true</item>
    </style>
</resources>
